# ── Base de données PostgreSQL ──
DATABASE_URL=postgresql://user:password@localhost:5432/tickway

# ── Serveur ──
PORT=3000
NODE_ENV=development
# URL publique du backend (ex: https://tickway.ci ou https://mon-backend.railway.app)
# Optionnel : utilisé pour générer le lien direct du QR code dans le mail
APP_URL=http://localhost:3000

# ── Clé d'accès pour l'endpoint /api/validate (équipe terrain) ──
# Générez une clé forte : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VALIDATE_API_KEY=CHANGEZ_MOI_clé_secrète_pour_validation

# ── E-mail (EmailJS) ──
# Obtenus sur votre tableau de bord EmailJS (https://dashboard.emailjs.com/)
EMAILJS_SERVICE_ID=service_zkdvg0w
EMAILJS_TEMPLATE_ID=template_kkd54a6
EMAILJS_PUBLIC_KEY=yTONDvVM6zOER6PEC
# Clé privée (Account > Security > Private Key), recommandée pour les appels backend :
EMAILJS_PRIVATE_KEY=votre_cle_privee

# ── CORS : origines autorisées (séparées par des virgules) ──
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
