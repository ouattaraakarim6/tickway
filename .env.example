# ── Base de données PostgreSQL ──
DATABASE_URL=postgresql://user:password@localhost:5432/tickway

# ── Serveur ──
PORT=3000
NODE_ENV=development
# URL publique du backend (ex: https://tickway.ci ou https://mon-backend.railway.app)
# Optionnel : utilisé pour générer le lien direct du QR code dans le mail
APP_URL=http://localhost:3000

# ── Paiement en ligne PaySecureHub / PAYHUB (https://docs.paysecurehub.com) ──
# URL publique de votre backend Express (indispensable pour recevoir l'IPN Url_Callback en production)
# Ex: https://tickway.onrender.com
API_PUBLIC_URL=
PAYSECUREHUB_BASE_URL=https://rest-airtime.paysecurehub.com
PAYSECUREHUB_API_KEY=votre_ApiKey_paysecurehub
PAYSECUREHUB_MERCHANT_ID=votre_MerchantId_paysecurehub

# ── Clé d'accès pour l'endpoint /api/validate (équipe terrain) ──
# Générez une clé forte : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VALIDATE_API_KEY=CHANGEZ_MOI_clé_secrète_pour_validation

# ── E-mail (EmailJS) ──
# Obtenus sur votre tableau de bord EmailJS (https://dashboard.emailjs.com/)
EMAILJS_SERVICE_ID=service_zkdvg0w
EMAILJS_TEMPLATE_ID=template_kkd54a6
EMAILJS_PUBLIC_KEY=yTONDvVM6zOER6PEC
# Clé privée (Account > Security > Private Key), recommandée pour les appels backend :
EMAILJS_PRIVATE_KEY=votre_cle_privee
# Optionnel — Templates EmailJS ou clé Resend pour les codes e-mail (vérification, mot de passe oublié, transferts) :
EMAILJS_AUTH_TEMPLATE_ID=
EMAILJS_TRANSFER_TEMPLATE_ID=
RESEND_API_KEY=
EMAIL_FROM=TickWay <onboarding@resend.dev>

# ── CORS : origines autorisées (séparées par des virgules) ──
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ── Supabase Auth (clé publique uniquement côté client/frontend) ──
SUPABASE_URL=https://vuahvbyianddnoapccpp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_u9CrvJ6nEv9FAq0g_fHuIg_pjSi_Fvm

# ── Secrets serveur uniquement (NE JAMAIS exposer côté frontend / client) ──
# Optionnel : requis uniquement pour les opérations admin serveur ou migration batch d'utilisateurs
SUPABASE_SECRET_KEY=
# Clé HMAC/AES dédiée au chiffrement des jetons éphémères de réinitialisation (32+ octets aléatoires en prod)
TICKWAY_RESET_SECRET=
