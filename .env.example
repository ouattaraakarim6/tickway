# ── Base de données MySQL ──
# Local (Laragon) : root sans mot de passe par défaut
DATABASE_URL=mysql://root:@127.0.0.1:3306/tickway
# o2switch : créez la base + l'utilisateur dans cPanel > Bases de données MySQL, puis :
# DATABASE_URL=mysql://cpaneluser_tickway:MOT_DE_PASSE@localhost:3306/cpaneluser_tickway
# (encodez les caractères spéciaux du mot de passe : @ -> %40, # -> %23, / -> %2F)

# ── Serveur ──
PORT=3000
NODE_ENV=development
# URL publique du site (ex: https://tickway.ci)
APP_URL=http://localhost:3000

# ── Secrets (OBLIGATOIRES en production, valeurs longues et aléatoires) ──
# Générez-les avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mot de passe du dashboard fondateur (utilisé uniquement à la première initialisation de la base) :
# reprenez le hash PBKDF2 existant (mêmes valeurs que le .env local) pour conserver le mot de passe actuel…
FOUNDER_AUTH_SALT=
FOUNDER_AUTH_HASH=
# …ou, à défaut, un nouveau mot de passe en clair (8+ caractères)
FOUNDER_PASSWORD=
# Clé de l'équipe terrain principale (16+ caractères ; utilisée uniquement à la première initialisation)
VALIDATE_API_KEY=
# Secret maître (32+ caractères) : chiffrement des jetons invités et protection des clés équipe.
# Ne le changez pas après la mise en production (les clés équipe existantes deviendraient invalides).
APP_SECRET=

# ── Paiement en ligne PaySecureHub / PAYHUB (https://docs.paysecurehub.com) ──
# URL publique du backend (indispensable pour recevoir l'IPN Url_Callback en production)
API_PUBLIC_URL=
PAYSECUREHUB_BASE_URL=https://rest-airtime.paysecurehub.com
PAYSECUREHUB_API_KEY=
PAYSECUREHUB_MERCHANT_ID=

# ── E-mail des billets : SMTP de la messagerie o2switch (cPanel > Comptes de messagerie) ──
# Hôte : nom du serveur o2switch indiqué dans « Connecter les appareils » (ex. xxxx.o2switch.net) ou mail.tick-way.com
SMTP_HOST=
# 465 = SSL/TLS (recommandé) ; 587 = STARTTLS
SMTP_PORT=465
# Adresse complète de la boîte d'envoi (ex. billets@tick-way.com) et son mot de passe
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché (par défaut « TickWay <SMTP_USER> ») et adresse de réponse optionnelle
MAIL_FROM=
MAIL_REPLY_TO=

# ── CORS : origines autorisées en production (séparées par des virgules) ──
CORS_ORIGINS=http://localhost:3000
